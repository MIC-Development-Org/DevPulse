# DevPulse Environment Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_MOCK=true
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_QUIZ_PASS_PERCENTAGE=80

# ---------------------------------------------------------------------------
# Frontend (Next.js only). Database variables belong to the Express backend
# now — see backend/.env.example. NEXT_PUBLIC_API_BASE_URL becomes relevant
# once the frontend switches from mock data to live backend calls (planned
# via the ApiClient HTTP adapter; unused by code for now).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Authentication (Phase 2 — Auth.js v5 runs in the frontend; these follow the
# Auth.js conventions and must match the app origin.)
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_URL="http://localhost:3000"

