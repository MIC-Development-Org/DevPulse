# DevPulse Environment Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Mock adapter selection (adapter.ts): absent/"true" = pure in-browser mock
# data (kept for mock-mode development); "false" = Phase 4 HYBRID — tracks,
# modules and quiz questions come from the live DB-backed API (BFF → Express
# → PostgreSQL) while profile/progress/quiz-submission stay mock until
# Phase 5. NEXT_PUBLIC_* values are inlined at BUILD time — changing this
# requires a rebuild. In production the mock adapter hard-fails startup
# (guard.server.ts), so production builds must explicitly set this to
# "false"; there is no sanctioned escape hatch anymore.
NEXT_PUBLIC_API_MOCK=true
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_QUIZ_PASS_PERCENTAGE=80

# ---------------------------------------------------------------------------
# Frontend (Next.js only). Database variables belong to the Express backend
# now — see backend/.env.example.
#
# NEXT_PUBLIC_API_BASE_URL was REMOVED (Phase 3): browser code never calls
# Express directly. All live traffic goes through same-origin Next.js BFF
# routes, so only NEXT_PUBLIC_APP_URL (browser-known origin) remains. See
# docs/environments.md for the full dev/e2e/prod/Docker matrix and the
# mock-flag semantics (values are inlined at BUILD time by Next.js).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Authentication (Phase 2 — Auth.js v5 runs in the frontend).
# ---------------------------------------------------------------------------
# Random 32-byte secret, server-side only. Generate locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-secure-random-secret"
AUTH_URL="http://localhost:3000"

# Production ONLY: the backend/edge in front of Next.js is our own trusted
# component, so v5's per-default-strict production host check is opened with
# the Auth.js-supported switch (host headers from untrusted origins are
# otherwise rejected). Never set this for exposed public origins that you do
# not control.
# AUTH_TRUST_HOST=true

# E2E/local prod-build escape hatch ONLY (Playwright sets this itself):
# drops the __Secure- cookie prefix + Secure flag for plain-http localhost.
# Never enable for real deployments.
# AUTHJS_SESSION_COOKIE_INSECURE=true

# Express origin used by SERVER-ONLY code (BFF route handlers / Auth.js
# authorize). Must NOT be NEXT_PUBLIC_*, and must be https:// in production —
# see backend/docs/auth-integration.md.
BACKEND_INTERNAL_URL=http://localhost:4000

# Database URL — used ONLY by the Auth.js Prisma adapter (Session rows).
# This mirrors backend/.env's DATABASE_URL; keep both in sync when the
# database changes. See backend/docs/auth-integration.md (plan risk R1).
DATABASE_URL=postgresql://devpulse:change-this-password@localhost:5433/devpulse?schema=public

# GitHub OAuth (optional). Provide BOTH to enable the provider in Auth.js;
# leave unset for local development. Secrets live only here in the frontend.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

