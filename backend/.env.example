# DevPulse Backend — environment template.
# Copy to .env (git-ignored) and fill in real values.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the Next.js frontend origin(s))
CORS_ORIGINS=http://localhost:3000

# PostgreSQL — same Docker instance managed by the root docker-compose.yml
# (postgres:18-alpine, container devpulse-db, host port 5433 -> container 5432)
DATABASE_URL=postgresql://devpulse:change-this-password@localhost:5433/devpulse?schema=public

# --------------------------------------------------------------------------
# Authentication (Phase 2). Auth.js v5 runs in the Next.js frontend, which is
# also where AUTH_SECRET/AUTH_URL live; this backend validates credentials and
# database-backed sessions. OAuth client secrets (GitHub) live in the FRONTEND
# env only — never here.
# --------------------------------------------------------------------------

# Argon2id password hashing (OWASP Password Storage defaults; tune only after
# running `npm run bench:argon2` on the target environment).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Rate limiting for /auth/register and /auth/login (per client IP).
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Rate limiting for Phase 5 user-progress mutations (per client IP).
# POST /me/quiz/submissions persists a graded attempt each — tighter cap.
RATE_LIMIT_QUIZ_SUBMIT_MAX=20
RATE_LIMIT_QUIZ_SUBMIT_WINDOW_MS=300000
RATE_LIMIT_PROGRESS_MAX=60
RATE_LIMIT_PROGRESS_WINDOW_MS=300000

# Express 5 `trust proxy` setting (trusted hops in front of this server).
# INTENDED PRODUCTION POSTURE: Express is reached ONLY via the Next.js BFF on
# a private server-to-server network (see docs/auth-integration.md). Set this
# to a positive integer only when a reverse proxy actually exists in front of
# Express — and if Express is ever exposed publicly, the documented mandatory
# upgrade is the HMAC server-to-server assertion, not this variable.
TRUST_PROXY=0
