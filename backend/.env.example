# DevPulse Backend — environment template.
# Copy to .env (git-ignored) and fill in real values.

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the Next.js frontend origin(s))
CORS_ORIGINS=http://localhost:3000

# PostgreSQL — same Docker instance managed by the root docker-compose.yml
# (postgres:18-alpine, container devpulse-db, host port 5433 -> container 5432)
DATABASE_URL=postgresql://devpulse:change-this-password@localhost:5433/devpulse?schema=public

# --------------------------------------------------------------------------
# Authentication (Phase 2). Auth.js v5 runs in the Next.js frontend, which is
# also where AUTH_SECRET/AUTH_URL live today; the backend validates sessions
# against the shared database. No auth env vars are needed here yet.
# --------------------------------------------------------------------------
